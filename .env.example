# Copy to .env.local and fill in. Without these, the site runs in demo mode.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHALLENGE_SLUG=21-day-sports-challenge

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ₹99 entry is paid by GPay / UPI QR. Put the QR image at public/payments/upi-qr.png
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Fem Rise Club

# Not used right now — only needed if you switch to Razorpay later.
# Razorpay → Settings → API Keys / Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: protects /api/cron/deadlines if you use Vercel Cron instead of pg_cron
CRON_SECRET=
